{
  "description": "Claudeignore hook that controls file access using .claudeignore files with gitignore syntax",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/claudeignore-hook.js"
          }
        ]
      }
    ]
  }
}
